function blockedByFurniture(scene,x,y){
 if(scene==='quarto'){
  // Parede de trás; a abertura da escada permanece transitável em x16–17, y3.
  if(y>=1&&y<=2&&!(x>=16&&x<=17))return true;
  // Cama, escrivaninha/despertador, estante com PC e TV.
  if(x>=1&&x<=3&&y>=4&&y<=7)return true;
  if(x>=4&&x<=5&&y>=4&&y<=5)return true;
  if(x>=2&&x<=4&&y>=2&&y<=3)return true;
  if(x>=7&&x<=10&&y>=2&&y<=3)return true;
