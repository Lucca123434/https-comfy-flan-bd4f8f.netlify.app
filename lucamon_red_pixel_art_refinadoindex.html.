function pcStore(){if(g.party.length<=1){say('Você precisa manter ao menos um Pokémon na equipe.');return}say('Qual Pokémon deseja guardar?',g.party.map((p,i)=>[p.nickname,()=>{g.pc.push(g.party.splice(i,1)[0]);save();say('Pokémon guardado no PC.')}]))}
function pcTake(){if(g.party.length>=6){say('Sua equipe já tem seis Pokémon.');return}if(!g.pc.length){say('O PC está vazio.');return}say('Qual Pokémon deseja retirar?',g.pc.map((p,i)=>[p.nickname,()=>{g.party.push(g.pc.splice(i,1)[0]);save();say('Pokémon retirado do PC.')}]))}
function shop(){if(g.returnTo==='viridian'&&g.mission>=4&&g.mission<5&&!g.package){g.package=true;g.items.potion++;save();say('O atendente entrega o pacote para o Professor Carvalho. Você recebeu uma Poção. Volte ao laboratório!');return}say('Loja Pokémon — você tem '+g.money+' moedas.', [['Poção — 10 moedas',()=>{if(g.money<10){say('Você não tem moedas suficientes.');return}g.money-=10;g.items.potion++;save();say('Você comprou uma Poção.')}],['Poké Bola — 20 moedas',()=>{if(g.money<20){say('Você não tem moedas suficientes.');return}g.money-=20;g.items.pokeball++;save();say('Você comprou uma Poké Bola.')}],['Sair',()=>{}]])}
function bagOpen(){menu=false;let use=()=>{if(!g.items.potion){say('Você não tem Poções.',[['Voltar',bagOpen]]);return}let targets=g.party.map((p,i)=>({p,i})).filter(x=>x.p.hp>0&&x.p.hp<x.p.max);if(!targets.length){say('Nenhum Pokémon saudável precisa de cura agora.',[['Voltar',bagOpen]]);return}say('Escolha um Pokémon para usar a Poção.',targets.map(({p,i})=>[p.nickname+' — HP '+p.hp+'/'+p.max,()=>{g.items.potion--;let before=p.hp;p.hp=Math.min(p.max,p.hp+20);save();say(p.nickname+' recuperou '+(p.hp-before)+' pontos de vida.')}]).concat([['Voltar',bagOpen]]))};say('Mochila — '+g.money+' moedas · Poké Bolas: '+g.items.pokeball+' · Safari Balls: '+g.items.safariBall+' · Poções: '+g.items.potion,[['Usar Poção',use],['Voltar',()=>menuOpen()]])}function menuOpen(){menu=true;say('Menu de aventura', [['Equipe',()=>{menu=false;say(g.party.length?g.party.map(p=>p.nickname+' Nv.'+p.level+' HP '+p.hp+'/'+p.max).join(' · '):'Sua equipe está vazia.')}],['Mochila',bagOpen],['Insígnias',()=>{menu=false;say(g.badgeNames.length?g.badgeNames.join(' · '):'Você ainda não conquistou insígnias.')}],['Pokédex',()=>{menu=false;say(g.pokedexObtained?'Pokémon registrados: '+(g.pokedex.join(', ')||'nenhum'):'Você ainda não recebeu a Pokédex. Leve o pacote da loja ao Professor Carvalho.')}],['Salvar',()=>{menu=false;save();say('Progresso salvo.')}],['Voltar',()=>{menu=false}]])}
function key(e){let k=e.key.toLowerCase();if(['arrowup','arrowdown','arrowleft','arrowright',' '].includes(k))e.preventDefault();if(box.classList.contains('show')){if(k==='escape'||k==='x'){if(!battle)close();return}if(k==='enter'||k==='z'){(document.activeElement?.tagName==='BUTTON'?document.activeElement:box.querySelector('button'))?.click();return}if(k==='arrowup'||k==='arrowdown'){let bs=[...box.querySelectorAll('button')],i=bs.indexOf(document.activeElement);if(bs.length){i=(i+(k==='arrowdown'?1:-1)+bs.length)%bs.length;bs[i].focus()}return}return}if(k==='arrowup'||k==='w')move(0,-1);else if(k==='arrowdown'||k==='s')move(0,1);else if(k==='arrowleft'||k==='a')move(-1,0);else if(k==='arrowright'||k==='d')move(1,0);else if(k==='z'||k==='enter')interact();else if(k==='x'||k==='escape')menuOpen()}
window.addEventListener('keydown',key);
function startNew(){g=newState();battle=null;save();draw();say('Bem-vindo! Você acordou em seu quarto em Pallet Town. Desça as escadas e converse com sua mãe.',[['Começar',()=>{}]])}
function showTitle(){let has=hasSave();let choices=[['Novo jogo',startNew]];if(has)choices.push(['Continuar',()=>{load();draw();say('Jornada carregada. '+objective())}]);choices.push(['Opções',()=>say('Controles: setas ou WASD para andar, Z ou Enter para conversar e escolher, X ou Esc para abrir o menu. O progresso é salvo automaticamente.',[['Voltar ao título',showTitle]])]);say('JORNADA EM KANTO · A aventura começa em Pallet Town.',choices)}
function init(){load();draw();document.querySelector('#cover-start').addEventListener('click',()=>{document.querySelector('#lucamon-cover').hidden=true;showTitle()});document.querySelector('#cover-continue').addEventListener('click',()=>{document.querySelector('#lucamon-cover').hidden=true;if(hasSave()){load();draw();say('Jornada carregada. '+objective())}else showTitle()})}
init();
})();
</script></body></html>
